# Reference only: main.py reads process environment and does not auto-load .env.
# Cloud: ordinary settings use Environment variables.
# MINGJING_TOKEN must be a development-only local login value, never production.
ZHIMING_BASE=./private/cloud-local
ZHIMING_SKILL=./hermes
MINGJING_TOKEN=
MINGJING_OWNER_ID=primary
ZHIMING_TOKEN_OWNERS={}

# AI provider: Anthropic-compatible POST <KIMI_BASE_URL>/messages.
# Use the real model name offered by your provider.
# Cloud: KIMI_API_KEY uses Network secret with the provider's allowed HTTPS 443 host.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# Optional local assets; no production database or model path is included.
HERMES_DB=./private/cloud-local/hermes-not-connected.db
# CHART_PYTHON=/absolute/path/to/chart-venv/bin/python
# ZHIMING_EMBEDDING_MODEL=/absolute/path/to/minilm
ZHIMING_CONTEXT_TOKENS=64000
ZHIMING_REPLY_RESERVE=18000
ZHIMING_TRACE_RETENTION_DAYS=30
