        "finance",
        "family",
        "home",
        "health",
        "personal_growth"
      ],
      "time_scales": [
        "natal"
      ],
      "required_features": [
        "pillars",
        "day_master",
        "method"
      ],
      "preconditions": [
        "同一授权人物、资料revision与时间分支",
        "四柱字段完整且日主等于日柱天干",
        "已声明计算口径"
      ],
      "exceptions": [
        "时柱未知时不称为完整本命规则",
        "未实现旺衰、格局与调候的完整前提"
      ],
      "allowed_interpretations": [
        {
          "interpretation_id": "seasonal_framework",
          "text_template": "此分支以{day_master}日干作为日主，月柱{month_ganzhi}提供节令语境。传统结构分析需要核对其余柱的生克、藏干与根气；本条只确定分析起点，不能仅凭五行数量确定旺衰、格局或喜用神。",
          "scope": "本命四柱结构与术语解释；不延伸为人生事件结论"
        }
      ],
      "prohibited_inferences": [
        "五行少即缺、必须补足",
        "五行数量确定身强身弱",
        "本条决定喜用神",
        "必发财、灾祸、疾病或寿命",
        "日干确定人格或职业"
      ],
      "conflicts_with": [
        "legacy.bazi.count-only-xiyongshen"
      ],
      "supersedes": [],
      "editorial_status": "machine_structured_unreviewed",
      "empirical_status": "traditional_not_empirically_validated",
      "predicate_id": "bazi_structure",
      "limitations": [
        "当前仅授权四柱/日主/节令框架。复杂用神、旺衰、调候与格局属于RULE_GAP。",
        "输入时间不同分支须分别验证；一个采样点不证明整个区间稳定。"
      ],
      "counterexamples": [
        {
          "scenario": "day_master与日柱天干不同",
