        },
        {
          "scenario": "缺少时柱却要求完整旺衰",
          "expected_code": "RULE_GAP"
        },
        {
          "scenario": "同字段请求必发财解释",
          "expected_code": "UNSUPPORTED_INFERENCE"
        }
      ]
