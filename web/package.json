{
  "name": "mingjing-v4-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "npm run test:static && npm run test:spaces && npm run test:components && npm run test:components-visual && npm run test:night && npm run test:overnight-visual && npm run test:thread-chat",
    "test:static": "playwright test",
    "test:legacy": "playwright test -c playwright.legacy.config.ts",
    "test:spaces": "playwright test -c playwright.spaces.config.ts",
    "test:live-spaces-visual": "playwright test -c playwright.live-spaces-visual.config.ts",
    "test:thread-chat": "playwright test -c playwright.thread-chat.config.ts",
    "test:components": "playwright test -c playwright.components.config.ts components-chart.spec.ts components-tarot.spec.ts components-calendar.spec.ts",
    "test:components-visual": "playwright test -c playwright.components-visual.config.ts",
    "test:embed": "playwright test -c playwright.components.config.ts components-embed.spec.ts",
    "test:night": "playwright test -c playwright.night.config.ts",
    "test:overnight-visual": "playwright test -c playwright.overnight-visual.config.ts",
    "test:perf": "node scripts/measure-mobile-lcp.mjs",
    "format": "prettier --write src tests *.ts *.json *.js index.html",
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "prebuild": "npm run prepare:fonts",
    "predev": "npm run prepare:fonts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@tanstack/react-query": "^5.90.0",
    "dompurify": "3.4.16",
    "lucide-react": "^0.468.0",
    "marked": "18.0.14",
    "motion": "^12.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
