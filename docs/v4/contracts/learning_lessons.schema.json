{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8 static synthetic learning curriculum and individual lesson draft",
  "oneOf": [
    {
      "$ref": "#/$defs/Curriculum"
    },
    {
      "$ref": "#/$defs/Lesson"
    }
  ],
  "$defs": {
    "LessonId": {
      "type": "string",
      "pattern": "^lesson-(0[1-9]|1[0-9]|20)$"
    },
    "Scope": {
      "type": "object",
      "properties": {
        "owner_user_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_user_id",
        "subject_id",
        "revision",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "SourceRegistry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "version": {
          "const": "p8-glossary-sources-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "properties": {
        "case_id": {
          "enum": [
            "ayuan-bazi",
            "ayuan-ziwei",
            "ayuan-astro"
          ]
        },
        "system": {
          "enum": [
            "bazi",
            "ziwei",
            "astro"
          ]
        },
        "chart_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "chart_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learning_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "learning_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learning_point_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^learning-[1-9][0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "case_id",
        "system",
        "chart_path",
        "chart_sha256",
        "learning_path",
        "learning_sha256",
        "learning_point_ids",
        "scope"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "case_id": {
          "enum": [
            "ayuan-bazi",
            "ayuan-ziwei",
            "ayuan-astro"
          ]
        },
        "c_alias": {
          "type": "string",
          "pattern": "^c[1-9][0-9]*$"
        },
        "relative_path": {
          "type": "string",
          "format": "json-pointer",
          "pattern": "^(?:/.*)?$"
        },
        "expected": {},
        "r_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^r[1-9][0-9]*$"
          }
        },
        "role": {
          "enum": [
            "primary",
            "rule_input",
            "basis"
          ]
        }
      },
      "required": [
        "evidence_id",
        "case_id",
        "c_alias",
        "relative_path",
        "expected",
        "r_aliases",
        "role"
      ],
      "additionalProperties": false
    },
    "LessonIndex": {
      "type": "object",
      "properties": {
        "lesson_id": {
          "$ref": "#/$defs/LessonId"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^lessons/lesson-(0[1-9]|1[0-9]|20)\\.json$"
        },
        "level": {
          "enum": [
            "入门",
            "基础",
            "中阶",
            "进阶",
            "跨体系"
          ]
        },
        "status": {
          "const": "draft_for_review"
        }
      },
      "required": [
        "lesson_id",
        "order",
        "title",
        "path",
        "level",
        "status"
      ],
      "additionalProperties": false
    },
    "Example": {
      "type": "object",
      "properties": {
        "case_id": {
          "enum": [
            "ayuan-bazi",
            "ayuan-ziwei",
            "ayuan-astro"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "learning_point_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^learning-[1-9][0-9]*$"
          }
        }
      },
      "required": [
        "case_id",
        "text",
        "evidence_ids",
        "learning_point_ids"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "option_id": {
          "enum": [
            "a",
            "b",
            "c"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "option_id",
        "text",
        "value"
      ],
      "additionalProperties": false
    },
    "Basis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "chart_observation",
                "matched_rule"
              ]
            },
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "expected": {}
          },
          "required": [
            "kind",
            "evidence_id",
            "expected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "concept"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "expected": {}
          },
          "required": [
            "kind",
            "source_ids",
            "expected"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Quiz": {
      "type": "object",
      "properties": {
        "quiz_id": {
          "type": "string",
          "pattern": "^lesson-(0[1-9]|1[0-9]|20)-q[12]$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "correct_option_id": {
          "enum": [
            "a",
            "b",
            "c"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        }
      },
      "required": [
        "quiz_id",
        "question",
        "options",
        "correct_option_id",
        "explanation",
        "basis"
      ],
      "additionalProperties": false
    },
    "School": {
      "type": "object",
      "properties": {
        "school": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "school",
        "note",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "Lesson": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "p8-learning-lesson-v1"
        },
        "lesson_id": {
          "$ref": "#/$defs/LessonId"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "入门",
            "基础",
            "中阶",
            "进阶",
            "跨体系"
          ]
        },
        "status": {
          "const": "draft_for_review"
        },
        "prerequisite_ids": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/LessonId"
          },
          "uniqueItems": true
        },
        "objectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paragraphs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "worked_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Example"
          }
        },
        "quiz": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Quiz"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "school_differences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/School"
          }
        },
        "pending_review": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "effects": {
          "const": {
            "new_rule_hits": 0,
            "model_calls": 0,
            "writes": 0
          }
        }
      },
      "required": [
        "schema_version",
        "lesson_id",
        "order",
        "title",
        "level",
        "status",
        "prerequisite_ids",
        "objectives",
        "paragraphs",
        "worked_examples",
        "quiz",
        "source_ids",
        "school_differences",
        "pending_review",
        "effects"
      ],
      "additionalProperties": false
    },
    "Curriculum": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "p8-learning-curriculum-v1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "draft_for_review"
        },
        "mode": {
          "const": "static_synthetic_only"
        },
        "lesson_count": {
          "const": 20
        },
        "quiz_count": {
          "const": 40
        },
        "source_registry": {
          "$ref": "#/$defs/SourceRegistry"
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Case"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 20,
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "lessons": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/LessonIndex"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "title",
        "status",
        "mode",
        "lesson_count",
        "quiz_count",
        "source_registry",
        "cases",
        "evidence",
        "lessons",
        "limits"
      ],
      "additionalProperties": false
    }
  }
}
